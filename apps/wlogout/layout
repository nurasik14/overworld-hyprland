{ "label" : "lock", "action" : "$HOME/.config/hypr/scripts/LockScreen.sh", "text" : "Lock", "keybind" : "l" }
{ "label" : "logout", "action" : "$HOME/.config/hypr/scripts/Logout.sh", "text" : "Save and Quit to Title", "keybind" : "e" }
{ "label" : "suspend", "action" : "systemctl suspend", "text" : "Sleep in Bed", "keybind" : "u" }
{ "label" : "hibernate", "action" : "systemctl hibernate", "text" : "Hibernate", "keybind" : "h" }
{ "label" : "reboot", "action" : "systemctl reboot", "text" : "Respawn", "keybind" : "r" }
{ "label" : "shutdown", "action" : "systemctl poweroff", "text" : "Quit Game", "keybind" : "s" }
