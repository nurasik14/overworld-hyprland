/* Overworld Hyprland — rofi theme (Day + Night): the creative inventory.
 * Loaded last from ~/.config/rofi/config.rasi via
 *   @theme "~/.config/overworld/rofi/current.rasi"
 * Colours: ~/.config/overworld/rofi/colors.rasi -> tokens/out/<mode>/rofi-colors.rasi (flipped by apps/apply-mode.sh).
 * Shape: the game's grey panel (white top/left bevel, dark bottom/right bevel, black outline) titled "Search Items",
 * a black text field, app rows with the icon in a slot, the selected slot highlighted white like a hovered slot,
 * modes as creative-inventory tabs. rofi has no multi-colour borders, so every bevel is two nested boxes.
 * JaKooLit's menus (emoji, clipboard, keybinds, wallpaper…) @import config.rasi and override widgets after this.
 * Fonts: Overworld Mojangles 12 pt = 16 px (crisp), Monocraft 13.5 pt = 18 px (crisp) — see docs/DESIGN.md.
 */

@import "~/.config/overworld/rofi/colors.rasi"

configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "Apps";
    display-run:                "Run";
    display-filebrowser:        "Files";
    display-window:             "Windows";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
    font:                       "Overworld Mojangles 12";
}

* {
    background-color:           transparent;
    text-color:                 @guiText;
    spacing:                    0px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px;
    border-radius:              0px;
}

window {
    location:                   center;
    anchor:                     center;
    width:                      700px;
    border:                     2px;
    border-color:               @panelOutline;
    background-color:           @panelOutline;
    cursor:                     "default";
}

mainbox {
    orientation:                vertical;
    children:                   [ "bevel-dark" ];
}
/* panel bevel: dark bottom/right edge around a light top/left edge around the grey body */
bevel-dark {
    border:                     0px 2px 2px 0px;
    border-color:               @panelShadow;
    background-color:           @panel;
    children:                   [ "bevel-light" ];
}
bevel-light {
    border:                     2px 0px 0px 2px;
    border-color:               @panelLight;
    background-color:           @panel;
    padding:                    10px 12px 12px 12px;
    spacing:                    8px;
    orientation:                vertical;
    children:                   [ "textbox-title", "inputbar", "message", "listview", "mode-switcher" ];
}

textbox-title {
    content:                    "Search Items";
    text-color:                 @guiTitle;
    background-color:           transparent;
    expand:                     false;
    padding:                    0px 0px 2px 0px;
}

/* the game's text field: black fill, grey outline (white when focused) */
inputbar {
    expand:                     false;
    children:                   [ "prompt", "entry" ];
    background-color:           @fieldFill;
    border:                     2px;
    border-color:               @fieldBorderFocus;
    padding:                    6px 8px;
    spacing:                    8px;
}
prompt {
    text-color:                 @chatYellow;
    background-color:           transparent;
    vertical-align:             0.5;
}
entry {
    text-color:                 @fieldText;
    placeholder:                "Search…";
    placeholder-color:          @fieldPlaceholder;
    cursor:                     text;
    cursor-color:               @fieldText;
    cursor-width:               2px;
    vertical-align:             0.5;
    background-color:           transparent;
}
message {
    background-color:           @bg1;
    border:                     2px;
    border-color:               @panelOutline;
    padding:                    6px 8px;
}
textbox {
    text-color:                 @guiText;
    background-color:           transparent;
}

/* the item grid: a sunken area (bg1) with the icons sitting in grey slots */
listview {
    columns:                    2;
    lines:                      8;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  true;
    spacing:                    4px;
    padding:                    4px;
    fixed-height:               true;
    background-color:           @bg1;
    border:                     2px;
    border-color:               @panelOutline;
}
/* scroller like the creative inventory: thin dark track, bevelled light thumb */
scrollbar {
    handle-width:               12px;
    handle-color:               @panelLight;
    background-color:           @slotDark;
    border:                     2px;
    border-color:               @panelOutline;
    margin:                     0px 0px 0px 4px;
}
element {
    orientation:                horizontal;
    spacing:                    10px;
    padding:                    4px 8px 4px 4px;
    border:                     2px;
    border-color:               transparent;
    background-color:           transparent;
    cursor:                     pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @guiText; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @error; }
element normal.active, element alternate.active { background-color: transparent; text-color: @accent; }
/* hovered / selected slot: white frame + translucent white fill (the game's slot highlight) */
element selected.normal { background-color: @slotHover; border-color: @borderActive; text-color: @guiText; }
element selected.urgent { background-color: @slotHover; border-color: @error;        text-color: @error; }
element selected.active { background-color: @slotHover; border-color: @borderActive; text-color: @accent; }
element-icon {
    size:                       32px;
    padding:                    4px;
    background-color:           @slot;
    border:                     2px;
    border-color:               @slotDark;
    vertical-align:             0.5;
}
element-text {
    vertical-align:             0.5;
    highlight:                  underline;
    text-color:                 inherit;
    background-color:           transparent;
}

/* creative-inventory tabs */
mode-switcher {
    expand:                     false;
    spacing:                    4px;
    background-color:           transparent;
}
button {
    padding:                    6px 14px;
    background-color:           @bg1;
    text-color:                 @guiText;
    border:                     2px;
    border-color:               @panelOutline;
    cursor:                     pointer;
    horizontal-align:           0.5;
}
button selected {
    background-color:           @panelLight;
    text-color:                 @guiTitle;
    border-color:               @borderActive;
}

error-message {
    padding:                    12px;
    background-color:           @panel;
    border:                     2px;
    border-color:               @error;
}
