[%General]
author=Overworld
comment=Overworld Hyprland - OverworldDay (Minecraft GUI: bevelled 1px-outline widgets, no rounding, generated by build.py)
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=true
group_toolbar_buttons=false
spread_progressbar=true
progressbar_thickness=8
composite=false
translucent_windows=false
blurring=false
popup_blurring=false
menu_shadow_depth=0
tooltip_shadow_depth=0
spread_menuitems=true
splitter_width=5
scroll_width=12
scroll_min_extent=32
scroll_arrows=false
combo_as_lineedit=true
inline_spin_indicators=true
slider_width=6
slider_handle_width=16
slider_handle_length=10
check_size=16
toolbar_icon_size=16
animate_states=false
transient_groove=false
transient_scrollbar=false
reduce_window_opacity=0
reduce_menu_opacity=0
small_icon_size=16
button_contents_shift=true
layout_spacing=4
layout_margin=6
submenu_overlap=0
submenu_delay=250
scrollbar_in_view=false
no_inactive_tab=false
tooltip_delay=-1
click_behavior=0
merge_menubar_with_toolbar=false
fill_rubberband=false

[GeneralColors]
window.color=#c6c6c6
base.color=#373737
alt.base.color=#404040
button.color=#6f6f6f
light.color=#ffffff
mid.light.color=#e2e2e2
dark.color=#555555
mid.color=#8e8e8e
highlight.color=#245018
inactive.highlight.color=#657f5e
text.color=#ffffff
window.text.color=#373737
button.text.color=#ffffff
disabled.text.color=#808080
tooltip.base.color=#100010
tooltip.text.color=#ffffff
highlight.text.color=#ffffff
link.color=#17358c
link.visited.color=#6c1a9c

[Hacks]
respect_darkness=true
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
blur_translucent=false
centered_forms=false
kinetic_scrolling=false
middle_click_scroll=false
opaque_colors=true
normal_default_pushbutton=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=0.6
lxqtmainmenu_iconsize=0
scroll_jump_workaround=false
single_top_toolbar=false
no_selection_tint=false
tint_on_mouseover=0
style_vertical_toolbars=false
transparent_menutitle=false
blur_only_active_window=false
respect_darkness_fix=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
indicator.size=9
text.normal.color=#ffffff
text.focus.color=#ffffa0
text.press.color=#ffffff
text.toggle.color=#ffffff
text.margin=1
text.iconspacing=4
indicator.element=arrow
text.margin.top=3
text.margin.bottom=3
text.margin.left=5
text.margin.right=5
text.shadow=1
text.shadow.xshift=1
text.shadow.yshift=1
text.shadow.color=#3f3f3f
text.shadow.alpha=255
text.shadow.depth=1

[PanelButtonTool]
inherits=PanelButtonCommand
interior.element=tbutton
frame.element=tbutton
text.normal.color=#373737
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.margin.top=2
text.margin.bottom=2
text.margin.left=2
text.margin.right=2
text.shadow=0

[Dock]
inherits=PanelButtonCommand
frame=true
interior=true
text.normal.color=#373737
text.shadow=0

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#373737
text.focus.color=#373737
text.bold=true
text.shadow=0

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=arrow
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.size=9
text.normal.color=#e0e0e0
text.focus.color=#e0e0e0
text.shadow=0

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.normal.color=#373737
text.focus.color=#373737
text.press.color=#373737
text.toggle.color=#373737
text.margin.left=4
text.shadow=0

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.normal.color=#373737
text.focus.color=#373737
text.press.color=#373737
text.toggle.color=#373737
text.margin.left=4
text.shadow=0

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color=#373737
text.shadow=0

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=3
text.margin.right=3
text.margin.top=3
text.margin.bottom=3
text.normal.color=#e0e0e0
text.focus.color=#e0e0e0
text.press.color=#e0e0e0
text.toggle.color=#e0e0e0
text.shadow=0

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand
text.normal.color=#373737
text.shadow=0

[Tab]
inherits=PanelButtonCommand
interior.element=tab
frame.element=tab
indicator.element=tab
text.margin.left=6
text.margin.right=6
text.margin.top=3
text.margin.bottom=3
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.normal.color=#373737
text.focus.color=#1a1a1a
text.press.color=#373737
text.toggle.color=#373737
min_width=+4
min_height=+2
text.shadow=0

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.shadow=0

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9
text.normal.color=#373737
text.shadow=0

[HeaderSection]
inherits=PanelButtonCommand
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
text.margin.top=2
text.margin.bottom=2

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=13

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
text.margin=0
frame=false
interior=false
text.normal.color=#373737
text.shadow=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.shadow=0

[SliderCursor]
inherits=PanelButtonCommand
frame=true
frame.element=slidercursor
interior=true
interior.element=slidercursor
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin=0
text.normal.color=#ffffff
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.bold=true
text.shadow=1
text.shadow.xshift=1
text.shadow.yshift=1
text.shadow.color=#000000
text.shadow.alpha=255
text.shadow.depth=1

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[ItemView]
inherits=PanelButtonCommand
text.margin=1
text.margin.top=1
text.margin.bottom=1
text.margin.left=2
text.margin.right=2
frame.element=itemview
interior.element=itemview
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.normal.color=#ffffff
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.shadow=0

[Splitter]
inherits=PanelButtonCommand
interior.element=splitter
frame=false
frame.top=0
frame.bottom=0
frame.left=1
frame.right=1
indicator.element=splitter-grip
indicator.size=14

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=9

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[ScrollbarGroove]
inherits=PanelButtonCommand
interior.element=scrollbargroove
frame.element=scrollbargroove
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=arrow
text.normal.color=#ffffff
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.shadow=0

[MenuBarItem]
inherits=PanelButtonCommand
interior.element=menubaritem
frame.element=menubaritem
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.left=6
text.margin.right=6
text.margin.top=2
text.margin.bottom=2
text.normal.color=#373737
text.focus.color=#ffffff
text.press.color=#ffffff
text.toggle.color=#ffffff
text.shadow=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
text.normal.color=#c0c0c0
text.focus.color=#ffffff
text.bold=true
text.shadow=0

[ComboBox]
inherits=PanelButtonCommand

[Menu]
