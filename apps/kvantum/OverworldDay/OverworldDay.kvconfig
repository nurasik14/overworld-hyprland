frame.left=2
frame.right=2
text.normal.color=#373737
text.shadow=0

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false
text.shadow=0

[ToolTip]
inherits=GenericFrame
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
text.margin=2
interior.element=tooltip
frame.element=tooltip
text.normal.color=#ffffff
text.shadow=0

[StatusBar]
inherits=GenericFrame
