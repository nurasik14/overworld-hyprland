// Overworld Hyprland — fastfetch with an ASCII creeper face (for terminals without the kitty graphics protocol, and the
// config `apply-mode.sh` falls back to when the grass-block PNG could not be built). Same @…@ template as overworld.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "file", "source": "~/.config/overworld/repo/apps/fastfetch/creeper.txt", "color": { "1": "@GREEN@", "2": "@BLACK@" }, "padding": { "top": 1, "left": 1, "right": 2 } },
  "display": {
    "color": { "keys": "@KEYS@", "title": "@TITLE@", "output": "@OUTPUT@", "separator": "@SEP@" },
    "separator": ": ",
    "key": { "type": "string" },
    "bar": { "border": { "left": "[", "right": "]" }, "char": { "elapsed": "■", "total": "·" }, "width": 12 },
    "percent": { "type": 3 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored} {#@SEP@}— Overworld Hyprland" },
    { "type": "custom", "format": "{#@SEP@}────────────────────────────────────" },
    { "type": "os",       "key": "Version",     "format": "{name} {version-id} ({id}/vanilla)" },
    { "type": "kernel",   "key": "Kernel",      "format": "{release}" },
    { "type": "uptime",   "key": "Time Played", "format": "{days}d {hours}h {minutes}m" },
    { "type": "packages", "key": "Items" },
    { "type": "shell",    "key": "Shell",       "format": "{pretty-name} {version}" },
    { "type": "wm",       "key": "Dimension",   "format": "{pretty-name} ({protocol-name})" },
    { "type": "terminal", "key": "Chat",        "format": "{pretty-name}" },
    "break",
    { "type": "cpu",      "key": "CPU",     "format": "{cores-logical}x {name}" },
    { "type": "gpu",      "key": "GPU",     "format": "{name}", "hideType": "integrated" },
    { "type": "display",  "key": "Display", "format": "{width}x{height} @{refresh-rate}Hz" },
    { "type": "memory",   "key": "Mem",     "format": "{percentage} {used}/{total} {percentage-bar}" },
    { "type": "disk",     "key": "World",   "folders": "/", "format": "{size-used}/{size-total} {size-percentage-bar}" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0 },
    { "type": "command", "key": "Splash", "keyColor": "@GOLD@", "text": "jq -r '.splashes[].text | select(length < 60)' ~/.config/overworld/repo/quotes/splashes.json 2>/dev/null | shuf -n1 || echo 'Also try Terraria!'" }
  ]
}
