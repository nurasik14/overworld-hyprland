# Overworld Hyprland — cava. apps/install.sh renders this + the [color] section of tokens/out/<mode>/cava.conf into
# ~/.config/overworld/cava/config-<light|dark>; ~/.config/cava/config is linked to ~/.config/overworld/cava/current.
# The user's original stays at ~/.config/cava/config.pre-overworld. Chunky blocks, like the XP bar.
[general]
framerate = 60
bars = 32
bar_width = 3
bar_spacing = 1
autosens = 1
sensitivity = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 10000
sleep_timer = 0

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average
reverse = 0

