    { "material": "glass", "class": "^(spotify|com\\.spotify\\.client|youtube-music|vlc|mpv|org\\.videolan\\.vlc|celluloid|io\\.mpv\\.mpv|obs|com\\.obsproject\\.studio|steam|steam_app_.*)$" },
