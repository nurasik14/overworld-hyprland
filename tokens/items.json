{
 "_comment": "App -> Minecraft item/block icon (assets/icons/mc/<name>.png). Keys = lower-cased Hyprland class / initialClass / desktop-id (sans .desktop). Evaluate _title_rules first (class regex + title regex), then the class key, then _default. Generated names resolve through tools/assetforge/render_icons.py.",
 "_default": "stone",
 "_empty": "empty",
 "_title_rules": [
  {
   "class": "kitty",
   "title": "(?i)hermes",
   "item": "enchanting_table",
   "note": "Hermes agent CLI in kitty"
  },
  {
   "class": "kitty",
   "title": "(?i)^(spf|superfile)\\b|superfile",
   "item": "chest",
   "note": "superfile file manager in kitty"
  },
  {
   "class": "kitty",
   "title": "(?i)\\bn?vim\\b|\\[nvim\\]|^nvim",
   "item": "writable_book",
   "note": "Neovim in kitty"
  },
  {
   "class": "kitty",
   "title": "(?i)\\bbtop\\b|\\bhtop\\b",
   "item": "comparator",
   "note": "system monitor TUI in kitty"
  },
  {
   "class": "kitty",
   "title": "(?i)\\bcava\\b|\\bncmpcpp\\b|\\bcmus\\b|\\bspotify_player\\b|\\bncspot\\b",
   "item": "music_disc_cat",
   "note": "music TUIs in kitty"
  },
  {
   "class": "kitty",
   "title": "(?i)\\bclaude\\b",
   "item": "name_tag",
   "note": "Claude Code CLI in kitty"
  },
  {
   "class": "kitty",
   "title": "(?i)\\bnmtui\\b|\\bbluetoothctl\\b",
   "item": "lever",
   "note": "settings TUIs in kitty"
  },
  {
   "class": ".*",
   "title": "(?i)youtube music|spotify",
   "item": "music_disc_cat",
   "note": "music in a browser tab"
  },
  {
   "class": ".*",
   "title": "(?i)minecraft",
   "item": "grass_block",
   "note": "any Minecraft window"
  }
 ],
