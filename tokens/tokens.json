{
  "meta": {
    "name": "Overworld Hyprland",
    "version": "2.0.0",
    "author": "design-director",
    "description": "Single source of truth for both modes. Colours are #rrggbb or #rrggbbaa (CSS order; Theme swaps to Qt order). Role names are stable; do not rename, add instead. Legacy role names (seal, jade, plum, herb, ink, paper…) are kept with Minecraft values so every generated app config keeps working.",
    "modes": [
      "light",
      "dark"
    ],
    "mode_names": {
      "light": "Day",
      "dark": "Night"
    },
    "mode_file": "~/.config/overworld/mode",
    "contrast_policy": "Roles in modes.<mode>.text_safe and all 16 ANSI colours (except the dark-mode terminal black ansi0) meet WCAG 4.5:1 on every ground (bg0, bg1, bg2, surface, surfaceAlt). ui_safe roles meet 3:1 and are for shapes/borders. decorative roles are exempt. chat* roles are the literal game §-colours, only for dark grounds (tooltips, chat, screens); on Day panels use Theme.chatReadable(code).",
    "sampled_from": "assets/mc/textures/gui/demo_background.png (panel pixels), gui/sprites/container/slot.png, block/deepslate_tiles.png (#373738), block/obsidian.png (#0F0B19). Chat colours and tooltip values are the game's documented constants."
  },
  "shared": {
    "radius": {
      "xs": 0,
      "sm": 0,
      "md": 0,
      "lg": 0,
      "pill": 0
    },
    "border": {
      "hairline": 2,
      "frame": 2,
      "focus": 2
    },
    "space": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "xxl": 32,
      "gutter": 16,
      "margin": 24
    },
    "sizes": {
      "bar_height": 44,
      "titlebar_height": 28,
      "seal_small": 14,
      "seal_medium": 24,
      "seal_large": 48,
      "control_height": 40,
      "control_height_large": 48,
      "hairline_inset": 4,
      "card_padding": 14,
      "icon": 16,
      "icon_large": 32,
      "gui_slot": 18,
      "gui_item": 16,
      "gui_button_h": 20,
      "gui_button_w": 150,
      "gui_button_wide": 200,
      "gui_button_small": 98
    },
    "type": {
      "families": {
        "display_cjk": "Overworld Mojangles",
        "title": "Overworld Mojangles",
        "body_cjk": "Overworld Mojangles",
        "jp_flavour": "Overworld Mojangles",
        "jp_brush": "Overworld Mojangles",
        "serif_latin_display": "Overworld Mojangles",
        "serif_latin_body": "Overworld Mojangles",
        "ui": "Overworld Mojangles",
        "ui_fallback": "Monocraft",
        "mono": "Monocraft",
        "mono_propo": "Monocraft"
      },
      "note": "size = px at the default GUI scale 2; QML uses units x 8 x Theme.gui. Bitmap fonts are only crisp at multiples of 8 px.",
      "roles": {
        "display": {
          "family": "Overworld Mojangles",
          "units": 3,
          "size": 48,
          "weight": 400,
          "line_height": 1.25,
          "use": "/title big text, world-card headers"
        },
        "display_sm": {
          "family": "Overworld Mojangles",
          "units": 2,
          "size": 32,
          "weight": 400,
          "line_height": 1.25,
          "use": "section heads, /title subtitle"
        },
        "title": {
          "family": "Overworld Mojangles",
          "units": 1,
          "size": 16,
          "weight": 400,
          "line_height": 1.25,
          "use": "panel titles (GUI title style), widget headers"
        },
        "subtitle": {
          "family": "Overworld Mojangles",
          "units": 1,
          "size": 16,
          "weight": 400,
          "line_height": 1.25,
          "use": "secondary line beside a title"
        },
        "body": {
          "family": "Overworld Mojangles",
          "units": 1,
          "size": 16,
          "weight": 400,
          "line_height": 1.25,
          "use": "body text, notification body"
        },
        "body_latin": {
          "family": "Overworld Mojangles",
          "units": 1,
          "size": 16,
          "weight": 400,
          "line_height": 1.35,
          "use": "quotes, long prose"
        },
        "ui": {
          "family": "Overworld Mojangles",
          "units": 1,
          "size": 16,
          "weight": 400,
          "line_height": 1.25,
          "use": "buttons, fields, lists, status"
        },
        "small": {
          "family": "Overworld Mojangles",
          "units": 1,
          "size": 16,
          "weight": 400,
          "line_height": 1.25,
          "use": "captions, timestamps, bar chips (a bitmap font has no smaller crisp size)"
        },
        "mono": {
          "family": "Monocraft",
          "units": 1,
          "size": 16,
          "weight": 400,
          "line_height": 1.25,
          "use": "F3 text, sysinfo, terminals, Nerd glyphs"
        },
        "clock_bar": {
          "family": "Overworld Mojangles",
          "units": 1,
          "size": 16,
          "weight": 400,
          "line_height": 1.0,
          "use": "bar clock HH:MM"
        },
        "clock_lock": {
          "family": "Overworld Mojangles",
          "units": 8,
          "size": 128,
          "weight": 400,
          "line_height": 1.0,
          "use": "hyprlock clock"
        },
        "shichen_lock": {
          "family": "Overworld Mojangles",
          "units": 6,
          "size": 96,
          "weight": 400,
          "line_height": 1.0,
          "use": "hyprlock secondary big text (legacy key)"
        },
        "quote_lock": {
          "family": "Overworld Mojangles",
          "units": 1,
          "size": 24,
          "weight": 400,
          "line_height": 1.3,
          "use": "hyprlock splash / quote"
        },
        "weather_temp": {
          "family": "Overworld Mojangles",
          "units": 3,
          "size": 48,
          "weight": 400,
          "line_height": 1.0,
          "use": "big temperature"
        }
      }
    },
    "motion": {
      "tick_ms": 50,
      "duration": {
        "fast": 150,
        "base": 250,
        "slow": 500,
        "theme_fade": 500,
        "wallpaper": 1200,
        "stagger": 40,
        "gui_fade": 150,
        "toast_slide": 500,
        "toast_hold": 5000,
        "tooltip_delay": 0
      },
      "ticks": {
        "title_in": 10,
        "title_stay": 70,
        "title_out": 20,
        "item_name_hold": 40,
        "item_name_fade": 10,
        "chat_hold": 200,
        "chat_fade": 20,
        "cursor_blink": 6,
        "toast_slide": 10,
        "button_highlight": 0
      },
      "easing": {
        "ink": {
          "bezier": [
            0.22,
            1.0,
            0.36,
            1.0
          ],
          "hyprland": "ink, 0.22, 1, 0.36, 1",
          "qml": "Easing.OutQuint",
          "css": "cubic-bezier(.22,1,.36,1)",
          "use": "legacy name: panels entering"
        },
        "brush": {
          "bezier": [
            0.65,
            0.0,
            0.35,
            1.0
          ],
          "hyprland": "brush, 0.65, 0, 0.35, 1",
          "qml": "Easing.InOutCubic",
          "css": "cubic-bezier(.65,0,.35,1)",
          "use": "legacy name: symmetric moves, cross-fades"
        },
        "drift": {
          "bezier": [
            0.33,
            1.0,
            0.68,
            1.0
          ],
          "hyprland": "drift, 0.33, 1, 0.68, 1",
          "qml": "Easing.OutCubic",
          "css": "cubic-bezier(.33,1,.68,1)",
          "use": "legacy name: workspaces, progress"
        },
        "block": {
          "bezier": [
            0.2,
            1.25,
            0.4,
            1.0
          ],
          "hyprland": "block, 0.2, 1.25, 0.4, 1",
          "qml": "Easing.OutBack",
          "css": "cubic-bezier(.2,1.25,.4,1)",
          "use": "window placed: pop-in with slight overshoot"
        },
        "toast": {
          "bezier": [
            0.55,
            0.085,
            0.68,
            0.53
          ],
          "hyprland": "toast, 0.55, 0.085, 0.68, 0.53",
          "qml": "Easing.InQuad",
          "css": "cubic-bezier(.55,.085,.68,.53)",
          "use": "toast slide (the game squares its progress)"
        }
      },
      "translate": {
        "panel": 0,
        "notification": 0,
        "osd": 0,
        "hover": 0
      },
      "hyprland": {
        "windowsIn": "2.5, block, popin 85%",
        "windowsOut": "2, brush, popin 85%",
        "windowsMove": "2.5, drift",
        "fade": "1.5, brush",
        "fadeDim": "1.5, brush",
        "workspaces": "3.5, drift, slide",
        "layers": "1.5, drift, fade",
        "layersIn": "1.5, drift, fade",
        "layersOut": "1.5, brush, fade",
        "border_angle": "off"
      },
      "reduced_motion": "config.json {\"reduced_motion\":true} or {\"animations\":false}: Theme.reducedMotion is true: durations 0 except theme_fade 150, no jiggle / pulse / sprite stepping; the tick clock keeps running for logic."
    },
    "shadow": {
      "card": {
        "x": 0,
        "y": 0,
        "blur": 0,
        "spread": 0,
        "opacity": 0.0
      },
      "panel": {
        "x": 0,
        "y": 0,
        "blur": 0,
        "spread": 0,
        "opacity": 0.0
      },
      "note": {
        "x": 2,
        "y": 2,
        "blur": 0,
        "spread": 0,
        "opacity": 0.25
      },
      "hyprland": {
        "range": 0,
        "render_power": 1,
        "offset": "0 0",
        "scale": 1.0,
        "enabled": false
      }
    },
    "blur": {
      "hyprland": {
        "enabled": false,
        "size": 6,
        "passes": 3,
        "vibrancy": 0.17,
        "noise": 0.02,
        "contrast": 0.9,
        "brightness": 0.95,
        "xray": false,
        "layers": [
          "bar",
          "launcher",
          "network",
          "power",
          "osd",
          "notifications"
        ]
      }
    },
    "opacity": {
      "card_transparent": 0.72,
      "surface": 1.0,
      "texture_overlay": {
        "light": 0.0,
        "dark": 0.0
      },
      "ink_wash_hover": 0.5,
      "ink_wash_pressed": 0.5,
      "disabled": 0.55,
      "dim_inactive": 0.05,
      "scrim": 0.75,
      "bar": 1.0,
      "drawer_hover_lift": 1.0,
      "widget_default": 0.72,
      "slot_hover": 0.5,
      "texture_overlay_note": "legacy paper/lacquer grain overlays are off (0). disabled is for unported modules; Mc* widgets use their own disabled sprites."
    },
    "textures": {
      "panel_reference": "gui/demo_background",
      "menu_background": "gui/menu_background",
      "inworld_menu_background": "gui/inworld_menu_background",
      "header_separator": "gui/header_separator",
      "footer_separator": "gui/footer_separator",
      "note": "paths are relative to the texture root; resolve with Theme.tex()"
    },
    "gui": {
      "default_scale": 2,
      "min": 1,
      "max": 4,
      "font_unit": 8,
      "auto_rule": "floor(min(screenW/960, screenH/540)) clamped to 1..4 (1920x1080 -> 2). The game's own Auto would give 4 at 1080p, too large for a desktop shell."
    }
  },
